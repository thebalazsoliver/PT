---
import "../styles/global.css";

const packages = [
  {
    number: "01",
    name: "Foundation",
    price: "$329",
    cadence: "/ month",
    summary: "Build consistency with smart coaching and a clear weekly plan.",
    features: ["4 private training sessions", "Personalized gym program", "Monthly movement check-in", "Habit-based nutrition guide"],
    cta: "Start strong",
  },
  {
    number: "02",
    name: "Momentum",
    price: "$549",
    cadence: "/ month",
    summary: "Hands-on training and nutrition support for faster, sustainable progress.",
    features: ["8 private training sessions", "Custom strength & conditioning plan", "Weekly progress reviews", "Personalized calories & macros", "Direct coach messaging"],
    cta: "Build momentum",
    featured: true,
  },
  {
    number: "03",
    name: "Complete",
    price: "$849",
    cadence: "/ month",
    summary: "A high-touch performance partnership built around your whole lifestyle.",
    features: ["12 private training sessions", "Full training periodization", "Weekly nutrition coaching", "Meal structure & grocery strategy", "Priority scheduling and support"],
    cta: "Go all in",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Personal strength coaching and practical nutrition support with Coach Malik at REBELfit 247." />
    <meta name="theme-color" content="#0a0b0b" />
    <title>Forge Method Personal Training</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Forge Method home">
        <span class="brand-mark">F</span>
        <span>FORGE<span class="muted">/METHOD</span></span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="#packages">Packages</a>
        <a href="#location">Location</a>
      </nav>
      <a class="button button-small" href="#contact">Book a call <span aria-hidden="true">↗</span></a>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Strength · Movement · Nutrition</p>
          <h1>Stronger<br /><em>every day.</em></h1>
          <p class="hero-lede">Focused coaching for people who want to get stronger, move better, and build habits that last beyond the gym.</p>
          <div class="hero-actions">
            <a class="button" href="#packages">Explore coaching <span aria-hidden="true">↓</span></a>
            <a class="text-link" href="#about">Meet your coach <span aria-hidden="true">→</span></a>
          </div>
          <div class="proof-row">
            <div><strong>8+</strong><span>Years coaching</span></div>
            <div><strong>200+</strong><span>Clients guided</span></div>
            <div><strong>1:1</strong><span>Personal support</span></div>
          </div>
        </div>
        <div class="hero-visual" role="img" aria-label="Coach Malik standing in a dark training gym">
          <div class="hero-caption"><span>01</span><p>Strength coach<br />Nutrition guide</p></div>
        </div>
      </section>

      <section class="marquee" aria-label="Coaching principles">
        <div><span>Move with purpose</span><i>✦</i><span>Train with intent</span><i>✦</i><span>Eat with confidence</span></div>
      </section>

      <section class="journey" id="about" aria-labelledby="journey-title">
        <div class="journey-sticky">
          <div class="journey-topline">
            <div class="section-label"><span>01</span> The journey</div>
            <p>Scroll to move forward <span aria-hidden="true">↓</span></p>
          </div>

          <div class="journey-heading">
            <h2 id="journey-title">The work changes <em>everything.</em></h2>
          </div>

          <div class="journey-stage">
            <div class="journey-steps">
              <article class="journey-step journey-step-one">
                <span class="journey-index">01 / Decide</span>
                <div class="journey-message">
                  <p>Today you decide that you <strong>start your journey.</strong></p>
                  <p class="journey-message-color" aria-hidden="true">Today you decide that you <strong>start your journey.</strong></p>
                </div>
              </article>

              <article class="journey-step journey-step-two">
                <span class="journey-index">02 / Work</span>
                <div class="journey-message">
                  <p>We start the work <strong>together.</strong></p>
                  <p class="journey-message-color" aria-hidden="true">We start the work <strong>together.</strong></p>
                </div>
              </article>

              <article class="journey-step journey-step-three">
                <span class="journey-index">03 / Results</span>
                <div class="journey-message">
                  <p>In weeks, not only you but <strong>others will see the results.</strong></p>
                  <p class="journey-message-color" aria-hidden="true">In weeks, not only you but <strong>others will see the results.</strong></p>
                </div>
              </article>
            </div>

            <div class="triangle-build" role="img" aria-label="Three separate pyramid levels fill with lime liquid as the journey progresses">
              <p class="triangle-build-label"><span>Build</span> the result</p>
              <svg class="triangle-assembly" viewBox="0 0 420 410" aria-hidden="true">
                <defs>
                  <linearGradient id="lime-liquid" x1="0" y1="1" x2="0" y2="0">
                    <stop offset="0" stop-color="#66841f"></stop>
                    <stop offset=".58" stop-color="#8fb830"></stop>
                    <stop offset="1" stop-color="#afd744"></stop>
                  </linearGradient>
                  <clipPath id="level-one-clip">
                    <path d="M210 14L269 128H151Z"></path>
                  </clipPath>
                  <clipPath id="level-two-clip">
                    <path d="M139 151H281L336 256H84Z"></path>
                  </clipPath>
                  <clipPath id="level-three-clip">
                    <path d="M72 279H348L410 398H10Z"></path>
                  </clipPath>
                  <clipPath id="water-one-clip">
                    <path class="water-mask water-mask-one" d="M110 128C160 128 190 128 230 128S290 128 310 128V140H110Z"></path>
                  </clipPath>
                  <clipPath id="water-two-clip">
                    <path class="water-mask water-mask-two" d="M55 256C125 256 175 256 225 256S315 256 365 256V270H55Z"></path>
                  </clipPath>
                  <clipPath id="water-three-clip">
                    <path class="water-mask water-mask-three" d="M0 398C95 398 155 398 215 398S345 398 420 398V410H0Z"></path>
                  </clipPath>
                </defs>

                <path class="pyramid-shell" d="M210 14L269 128H151Z"></path>
                <g clip-path="url(#level-one-clip)">
                  <g clip-path="url(#water-one-clip)">
                    <path class="liquid-body" d="M110 14H310V140H110Z"></path>
                    <g class="liquid-bubbles">
                      <circle cx="190" cy="56" r="6"></circle><circle cx="226" cy="78" r="4"></circle><circle cx="208" cy="108" r="2.5"></circle>
                    </g>
                  </g>
                  <path class="water-surface water-surface-one" d="M110 128C160 128 190 128 230 128S290 128 310 128"></path>
                </g>
                <path class="pyramid-outline" d="M210 14L269 128H151Z"></path>

                <path class="pyramid-shell" d="M139 151H281L336 256H84Z"></path>
                <g clip-path="url(#level-two-clip)">
                  <g clip-path="url(#water-two-clip)">
                    <path class="liquid-body" d="M55 151H365V270H55Z"></path>
                    <g class="liquid-bubbles">
                      <circle cx="154" cy="190" r="7"></circle><circle cx="236" cy="176" r="4"></circle><circle cx="270" cy="218" r="5"></circle><circle cx="203" cy="238" r="2.5"></circle>
                    </g>
                  </g>
                  <path class="water-surface water-surface-two" d="M55 256C125 256 175 256 225 256S315 256 365 256"></path>
                </g>
                <path class="pyramid-outline" d="M139 151H281L336 256H84Z"></path>

                <path class="pyramid-shell" d="M72 279H348L410 398H10Z"></path>
                <g clip-path="url(#level-three-clip)">
                  <g clip-path="url(#water-three-clip)">
                    <path class="liquid-body" d="M0 279H420V410H0Z"></path>
                    <g class="liquid-bubbles">
                      <circle cx="118" cy="330" r="7"></circle><circle cx="182" cy="309" r="4"></circle><circle cx="247" cy="351" r="8"></circle><circle cx="304" cy="322" r="3"></circle><circle cx="216" cy="378" r="2.5"></circle>
                    </g>
                  </g>
                  <path class="water-surface water-surface-three" d="M0 398C95 398 155 398 215 398S345 398 420 398"></path>
                </g>
                <path class="pyramid-outline" d="M72 279H348L410 398H10Z"></path>
              </svg>
              <span class="triangle-complete">
                <span class="triangle-complete-step triangle-complete-one">Decide</span>
                <i aria-hidden="true">·</i>
                <span class="triangle-complete-step triangle-complete-two">Work</span>
                <i aria-hidden="true">·</i>
                <span class="triangle-complete-step triangle-complete-three">Results</span>
              </span>
            </div>
          </div>

          <div class="journey-progress" aria-hidden="true"><span></span></div>
        </div>
      </section>

      <section class="packages section" id="packages">
        <div class="section-heading">
          <div class="section-label"><span>02</span> Coaching packages</div>
          <div>
            <p class="kicker">Choose your level of support</p>
            <h2>A plan for every<br /><em>starting point.</em></h2>
          </div>
        </div>
        <div class="package-grid">
          {packages.map((item) => (
            <article class:list={["package-card", { featured: item.featured }]}> 
              {item.featured && <div class="popular">Most popular</div>}
              <div class="package-number">{item.number}</div>
              <h3>{item.name}</h3>
              <p class="package-summary">{item.summary}</p>
              <div class="price"><strong>{item.price}</strong><span>{item.cadence}</span></div>
              <ul>
                {item.features.map((feature) => <li><span aria-hidden="true">✓</span>{feature}</li>)}
              </ul>
              <a class:list={["button", { "button-dark": item.featured }]} href="#contact">{item.cta} <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
        <p class="package-note">All packages begin with a complimentary 20-minute consultation. No long-term contract required.</p>
      </section>

      <section class="location section" id="location">
        <div class="location-copy">
          <div class="section-label light"><span>03</span> Where we train</div>
          <p class="kicker">Bradford, Ontario</p>
          <h2>Put in the work at <em>REBELfit 247.</em></h2>
          <p>A focused, fully equipped training environment where beginners feel welcome and experienced athletes can push their limits.</p>
          <a class="text-link light-link" href="https://www.google.com/maps/search/?api=1&query=REBELfit+247+Bradford+Ontario" target="_blank" rel="noreferrer">Open in Google Maps <span aria-hidden="true">↗</span></a>
        </div>
        <div class="map-wrap">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2864.6144035752523!2d-79.57616871576019!3d44.11194780717742!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x882ac5e4bf3d8d67%3A0x7604014a2a66421b!2sREBELfit%20247!5e0!3m2!1shu!2shu!4v1786829535945!5m2!1shu!2shu" width="600" height="450" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="REBELfit 247 location map"></iframe>
        </div>
      </section>

      <section class="cta section" id="contact">
        <p class="eyebrow"><span></span> Your strongest chapter starts here</p>
        <h2>Ready to build<br /><em>something lasting?</em></h2>
        <p>Tell me what you’re working toward. We’ll talk through your goals, your schedule, and the right place to start.</p>
        <a class="button" href="mailto:hello@forgemethod.ca?subject=Free%20coaching%20consultation">Book your free consultation <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer>
      <a class="brand" href="#top"><span class="brand-mark">F</span><span>FORGE<span class="muted">/METHOD</span></span></a>
      <p>Personal training &amp; nutrition coaching<br />Bradford, Ontario</p>
      <div><a href="#about">About</a><a href="#packages">Packages</a><a href="#location">Location</a></div>
      <p class="copyright">© 2026 Forge Method</p>
    </footer>

    <script type="module" is:inline>
      import { createTimeline, onScroll } from 'https://esm.sh/animejs';

      if (document.fonts?.ready) {
        await document.fonts.ready;
      }
      await new Promise((resolve) => requestAnimationFrame(resolve));

      const journey = document.querySelector('.journey');
      const progress = document.querySelector('.journey-progress span');
      const assembly = document.querySelector('.triangle-assembly');
      const masks = [...document.querySelectorAll('.water-mask')];
      const surfaces = [...document.querySelectorAll('.water-surface')];
      const steps = [...document.querySelectorAll('.journey-step')];
      const waterFrames = [
        {
          mask: [
            'M110 128C160 128 190 128 230 128S290 128 310 128V140H110Z',
            'M110 88C155 76 185 101 225 88S285 76 310 88V140H110Z',
            'M110 48C155 59 185 37 225 48S285 59 310 48V140H110Z',
            'M110 14C160 14 190 14 230 14S290 14 310 14V140H110Z',
          ],
          surface: [
            'M110 128C160 128 190 128 230 128S290 128 310 128',
            'M110 88C155 76 185 101 225 88S285 76 310 88',
            'M110 48C155 59 185 37 225 48S285 59 310 48',
            'M110 14C160 14 190 14 230 14S290 14 310 14',
          ],
        },
        {
          mask: [
            'M55 256C125 256 175 256 225 256S315 256 365 256V270H55Z',
            'M55 218C120 204 173 231 225 218S315 204 365 218V270H55Z',
            'M55 178C120 191 173 165 225 178S315 191 365 178V270H55Z',
            'M55 151C125 151 175 151 225 151S315 151 365 151V270H55Z',
          ],
          surface: [
            'M55 256C125 256 175 256 225 256S315 256 365 256',
            'M55 218C120 204 173 231 225 218S315 204 365 218',
            'M55 178C120 191 173 165 225 178S315 191 365 178',
            'M55 151C125 151 175 151 225 151S315 151 365 151',
          ],
        },
        {
          mask: [
            'M0 398C95 398 155 398 215 398S345 398 420 398V410H0Z',
            'M0 350C90 334 155 365 215 350S345 334 420 350V410H0Z',
            'M0 305C90 320 155 291 215 305S345 320 420 305V410H0Z',
            'M0 279C95 279 155 279 215 279S345 279 420 279V410H0Z',
          ],
          surface: [
            'M0 398C95 398 155 398 215 398S345 398 420 398',
            'M0 350C90 334 155 365 215 350S345 334 420 350',
            'M0 305C90 320 155 291 215 305S345 320 420 305',
            'M0 279C95 279 155 279 215 279S345 279 420 279',
          ],
        },
      ];

      if (journey && progress && assembly && masks.length === 3 && surfaces.length === 3 && steps.length === 3) {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.journey-message-color').forEach((message) => {
            message.style.clipPath = 'inset(0 0 0 0)';
            message.style.opacity = '1';
          });
          document.querySelectorAll('.triangle-complete-step').forEach((label) => {
            label.style.color = 'var(--lime)';
            label.style.opacity = '1';
          });
          masks.forEach((mask, index) => {
            mask.setAttribute('d', waterFrames[index].mask.at(-1));
            surfaces[index].setAttribute('d', waterFrames[index].surface.at(-1));
            surfaces[index].style.opacity = '.3';
          });
          progress.style.transform = 'scaleX(1)';
        } else {
          const isMobile = window.matchMedia('(max-width: 600px)').matches;

          createTimeline({
            autoplay: onScroll({
              target: journey,
              enter: 'top top',
              leave: 'bottom bottom',
              sync: true,
            }),
            defaults: { ease: 'inOut(3)' },
          })
            .add('.water-mask-one', {
              d: waterFrames[0].mask,
              duration: 650,
              ease: 'linear',
            }, 0)
            .add('.water-surface-one', {
              d: waterFrames[0].surface,
              opacity: [0, 1, 1, .3],
              duration: 650,
              ease: 'linear',
            }, 0)
            .add('.journey-step-one .journey-message-color', {
              ...(isMobile
                ? { opacity: [0, 1] }
                : { clipPath: ['inset(0 100% 0 0)', 'inset(0 0% 0 0)'] }),
              duration: 300,
            }, 650)
            .add('.triangle-complete-one', {
              color: ['#6f746f', '#d7ff51'],
              opacity: [.52, 1],
              duration: 300,
            }, 650)
            .add('.water-mask-two', {
              d: waterFrames[1].mask,
              duration: 650,
              ease: 'linear',
            }, 950)
            .add('.water-surface-two', {
              d: waterFrames[1].surface,
              opacity: [0, 1, 1, .3],
              duration: 650,
              ease: 'linear',
            }, 950)
            .add('.journey-step-two .journey-message-color', {
              ...(isMobile
                ? { opacity: [0, 1] }
                : { clipPath: ['inset(0 100% 0 0)', 'inset(0 0% 0 0)'] }),
              duration: 300,
            }, 1600)
            .add('.triangle-complete-two', {
              color: ['#6f746f', '#d7ff51'],
              opacity: [.52, 1],
              duration: 300,
            }, 1600)
            .add('.water-mask-three', {
              d: waterFrames[2].mask,
              duration: 650,
              ease: 'linear',
            }, 1900)
            .add('.water-surface-three', {
              d: waterFrames[2].surface,
              opacity: [0, 1, 1, .3],
              duration: 650,
              ease: 'linear',
            }, 1900)
            .add('.journey-step-three .journey-message-color', {
              ...(isMobile
                ? { opacity: [0, 1] }
                : { clipPath: ['inset(0 100% 0 0)', 'inset(0 0% 0 0)'] }),
              duration: 300,
            }, 2550)
            .add('.triangle-complete-three', {
              color: ['#6f746f', '#d7ff51'],
              opacity: [.52, 1],
              duration: 300,
            }, 2550)
            .add(progress, {
              scaleX: [0, 1],
              duration: 2850,
              ease: 'linear',
            }, 0);
        }
      }
    </script>
  </body>
</html>
